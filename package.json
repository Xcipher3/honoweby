{
  "name": "webhookapi",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint --fix",
    "test": "cross-env NODE_ENV=test vitest",
    "db:push": "drizzle-kit push",
    "reconcile": "tsx scripts/reconcile.ts",
    "explain:balance": "tsx scripts/explain-balance.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "~1.5.0",
    "@scalar/hono-api-reference": "^0.9.13",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.2",
    "hono": "^4.13.2",
    "hono-pino": "^0.10.1",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "stoker": "^2.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.1.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.32.0",
    "eslint-plugin-format": "^1.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
